{
  "app_name": "AI Finance POC",
  "package_name": "com.aifinance.poc",
  "description": "A two-screen expense POC: capture new spending on Add Expense and review totals and trends on Analytics, with Navigation Compose routes and tap handlers for submit, category pick, and chart or list drill-down. Uses local fake transactions aligned with the AI Personal Expense Assistant Figma flow.",
  "figma_url": "https://www.figma.com/design/Ysn4BBvXbVvpBmmMC7nxBz/AI-Personal-Expense-Assistant?node-id=0-1&p=f&t=BXhIL10A7On3kmp3-0",
  "requirements": "Ai Finance App with AddExpense Screen , Analytics Screen and proper navigation in these two also handle click listeners as well",
  "design": {
    "primary": "#8B5CF6",
    "on_primary": "#FFFFFF",
    "secondary": "#8E51FF",
    "background": "#FAFAFA",
    "surface": "#F5F5F7",
    "on_surface": "#0A0A0A",
    "error": "#F59E0B",
    "font_family": "Default",
    "spacing_unit_dp": 8,
    "corner_radius_dp": 16,
    "notes": "Imported from Figma file_content"
  },
  "modules": [
    {
      "path": "app",
      "type": "app",
      "purpose": "Hilt application, NavHost, bottom or top-level graph linking Add Expense and Analytics"
    },
    {
      "path": "core/common",
      "type": "core",
      "purpose": "Result types, dispatchers, date and money formatting"
    },
    {
      "path": "core/network",
      "type": "core",
      "purpose": "Retrofit-ready stubs for future AI categorization API"
    },
    {
      "path": "core/database",
      "type": "core",
      "purpose": "Room-ready placeholder; POC uses in-memory local source"
    },
    {
      "path": "core/ui",
      "type": "core",
      "purpose": "Material 3 theme, spacing, ExpenseAmountField, CategoryChipRow, SummaryCard"
    },
    {
      "path": "features/add_expense",
      "type": "feature",
      "purpose": "Expense entry form and save flow"
    },
    {
      "path": "features/analytics",
      "type": "feature",
      "purpose": "Spending analytics and category breakdown"
    }
  ],
  "features": [
    {
      "name": "add_expense",
      "description": "User enters amount, category, note, and date; Save persists locally and navigates or shows success; category chips and View Analytics link handle clicks.",
      "screens": [
        {
          "name": "AddExpenseScreen",
          "route": "add_expense",
          "title": "Add Expense",
          "purpose": "Create a new expense and optionally open Analytics after save",
          "sample_items": [
            "Groceries · PKR 2,450 · Today",
            "Fuel · PKR 1,200 · Yesterday",
            "Subscription · PKR 799 · Netflix"
          ],
          "ui_state": {
            "isLoading": "Boolean",
            "amountInput": "String",
            "selectedCategoryId": "String?",
            "categories": "List<ExpenseCategory>",
            "note": "String",
            "errorMessage": "String?",
            "saveSuccess": "Boolean"
          },
          "events": [
            "OnAmountChange",
            "OnCategoryClick",
            "OnNoteChange",
            "OnSaveClick",
            "OnViewAnalyticsClick"
          ]
        }
      ],
      "use_cases": [
        {
          "name": "GetExpenseCategoriesUseCase",
          "description": "Load selectable categories for chips",
          "inputs": [],
          "output": "Flow<List<ExpenseCategory>>"
        },
        {
          "name": "AddExpenseUseCase",
          "description": "Validate and persist a new expense",
          "inputs": [
            "amount",
            "categoryId",
            "note",
            "date"
          ],
          "output": "Result<Expense>"
        }
      ],
      "repository": "ExpenseRepository",
      "data_sources": [
        "local"
      ],
      "dependencies": []
    },
    {
      "name": "analytics",
      "description": "Shows month total, category breakdown, and recent expenses; period and category row clicks filter or highlight slices.",
      "screens": [
        {
          "name": "AnalyticsScreen",
          "route": "analytics",
          "title": "Analytics",
          "purpose": "Review spending summary and tap to filter by category or open Add Expense",
          "sample_items": [
            "This month · PKR 18,320 total",
            "Food 38% · Transport 22% · Bills 18%",
            "Top: Groceries PKR 6,940"
          ],
          "ui_state": {
            "isLoading": "Boolean",
            "periodLabel": "String",
            "totalAmount": "Money",
            "categoryBreakdown": "List<CategorySpend>",
            "recentExpenses": "List<Expense>",
            "selectedCategoryId": "String?",
            "errorMessage": "String?"
          },
          "events": [
            "Refresh",
            "OnPeriodClick",
            "OnCategoryBreakdownClick",
            "OnExpenseRowClick",
            "OnAddExpenseClick"
          ]
        }
      ],
      "use_cases": [
        {
          "name": "ObserveExpenseAnalyticsUseCase",
          "description": "Aggregate totals and percentages for the selected period",
          "inputs": [
            "period"
          ],
          "output": "Flow<Result<ExpenseAnalytics>>"
        },
        {
          "name": "ObserveRecentExpensesUseCase",
          "description": "Stream latest expenses for the list section",
          "inputs": [
            "limit"
          ],
          "output": "Flow<List<Expense>>"
        }
      ],
      "repository": "ExpenseRepository",
      "data_sources": [
        "local"
      ],
      "dependencies": [
        "add_expense"
      ]
    }
  ],
  "tech_decisions": {
    "di": "Hilt",
    "network": "Retrofit+OkHttp",
    "db": "Room",
    "ui": "Jetpack Compose+Material3",
    "navigation": "Navigation Compose",
    "async": "Coroutines+StateFlow"
  },
  "data_flow_mermaid": "flowchart LR\n  UI-->VM\n  VM-->UC\n  UC-->Repo\n  Repo-->Local",
  "optional_libraries": [],
  "integration": {
    "mode": "greenfield",
    "host_root": "",
    "app_module": "app",
    "compat": "green",
    "compat_label": "",
    "create_core_common": false,
    "create_core_ui": false,
    "create_version_catalog": false,
    "patch_settings": false,
    "patch_app_deps": false,
    "write_poc_entry": false,
    "wire_nav_only": false,
    "conflict_features": [],
    "files_to_create": [],
    "files_to_patch": [],
    "notes": []
  }
}