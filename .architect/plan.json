{
  "app_name": "AI Finance POC",
  "package_name": "com.aifinance.poc",
  "description": "A two-screen expense POC: capture new expenses on Add Expense and review spending summaries on Analytics, with Navigation Compose moving between both. Local fake expense data only; Figma informs layout and tokens.",
  "figma_url": "https://www.figma.com/design/Ysn4BBvXbVvpBmmMC7nxBz/AI-Personal-Expense-Assistant?node-id=0-1&p=f&t=BXhIL10A7On3kmp3-0",
  "requirements": "AI Finance app with Add Expense Screen and Analytics Screen and navigation in these screen",
  "design": {
    "primary": "#8B5CF6",
    "on_primary": "#FFFFFF",
    "secondary": "#8E51FF",
    "background": "#FAFAFA",
    "surface": "#F5F5F7",
    "on_surface": "#0A0A0A",
    "error": "#F59E0B",
    "font_family": "Default",
    "spacing_unit_dp": 8,
    "corner_radius_dp": 16,
    "notes": "Imported from Figma file_content"
  },
  "modules": [
    {
      "path": "app",
      "type": "app",
      "purpose": "Application shell, NavHost, bottom navigation between Add Expense and Analytics"
    },
    {
      "path": "core/common",
      "type": "core",
      "purpose": "Shared result types, dispatchers, extensions"
    },
    {
      "path": "core/network",
      "type": "core",
      "purpose": "Retrofit-ready scaffolding (unused in POC)"
    },
    {
      "path": "core/database",
      "type": "core",
      "purpose": "Room-ready scaffolding (optional in-memory/local JSON for POC)"
    },
    {
      "path": "core/ui",
      "type": "core",
      "purpose": "Design system: colors, typography, spacing, buttons, text fields, expense list row"
    },
    {
      "path": "features/addexpense",
      "type": "feature",
      "purpose": "Add and persist expense entries"
    },
    {
      "path": "features/analytics",
      "type": "feature",
      "purpose": "Aggregate and display spending analytics"
    }
  ],
  "features": [
    {
      "name": "addexpense",
      "description": "Form to enter amount, category, note, and date; saves to local store and refreshes analytics source.",
      "screens": [
        {
          "name": "AddExpenseScreen",
          "route": "addexpense",
          "title": "Add Expense",
          "purpose": "User records a new personal expense and submits it.",
          "sample_items": [
            "Groceries · $42.50",
            "Transport · $18.00",
            "Coffee · $5.75"
          ],
          "ui_state": {
            "isLoading": "Boolean",
            "amount": "String",
            "selectedCategoryId": "String?",
            "note": "String",
            "categories": "List<ExpenseCategory>",
            "isSaveEnabled": "Boolean",
            "errorMessage": "String?"
          },
          "events": [
            "AmountChanged",
            "CategorySelected",
            "NoteChanged",
            "SaveExpense",
            "SaveSuccess"
          ]
        }
      ],
      "use_cases": [
        {
          "name": "GetExpenseCategoriesUseCase",
          "description": "Load selectable expense categories for the form.",
          "inputs": [],
          "output": "Flow<List<ExpenseCategory>>"
        },
        {
          "name": "AddExpenseUseCase",
          "description": "Validate and persist a new expense.",
          "inputs": [
            "amount",
            "categoryId",
            "note",
            "date"
          ],
          "output": "Result<Unit>"
        }
      ],
      "repository": "ExpenseRepository",
      "data_sources": [
        "local"
      ],
      "dependencies": []
    },
    {
      "name": "analytics",
      "description": "Dashboard of totals, category breakdown, and recent transactions from local expenses.",
      "screens": [
        {
          "name": "AnalyticsScreen",
          "route": "analytics",
          "title": "Analytics",
          "purpose": "User reviews monthly total, category split, and recent expense list.",
          "sample_items": [
            "This month: $1,240",
            "Food 38%",
            "Shopping 22%",
            "Recent: Rent $900"
          ],
          "ui_state": {
            "isLoading": "Boolean",
            "monthlyTotal": "MoneyAmount",
            "categoryBreakdown": "List<CategorySpend>",
            "recentExpenses": "List<Expense>",
            "errorMessage": "String?"
          },
          "events": [
            "Refresh"
          ]
        }
      ],
      "use_cases": [
        {
          "name": "ObserveExpenseAnalyticsUseCase",
          "description": "Stream aggregated totals and breakdown from stored expenses.",
          "inputs": [],
          "output": "Flow<Result<ExpenseAnalytics>>"
        }
      ],
      "repository": "ExpenseRepository",
      "data_sources": [
        "local"
      ],
      "dependencies": [
        "addexpense"
      ]
    }
  ],
  "tech_decisions": {
    "di": "Hilt",
    "network": "Retrofit+OkHttp",
    "db": "Room",
    "ui": "Jetpack Compose+Material3",
    "navigation": "Navigation Compose",
    "async": "Coroutines+StateFlow"
  },
  "data_flow_mermaid": "flowchart LR\n  UI-->VM\n  VM-->UC\n  UC-->Repo\n  Repo-->Local",
  "optional_libraries": [],
  "integration": {
    "mode": "greenfield",
    "host_root": "",
    "app_module": "app",
    "compat": "green",
    "compat_label": "",
    "create_core_common": false,
    "create_core_ui": false,
    "create_version_catalog": false,
    "patch_settings": false,
    "patch_app_deps": false,
    "write_poc_entry": false,
    "wire_nav_only": false,
    "removed_features": [],
    "conflict_features": [],
    "ux_patches": [],
    "files_to_create": [],
    "files_to_patch": [],
    "notes": []
  }
}